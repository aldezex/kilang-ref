// |    = help: did you mean `area`?
// |    |
// | 25 -   printFloat(ares(Rect(2.0, 3.0)))
// | 25 +   printFloat(area(Rect(2.0, 3.0)))
type Shape {
  Circle(radius: Float)
  Rect(w: Float, h: Float)
}
fn area(s: Shape) -> Float {
  match s {
    Circle(r) => 3.141592653589793 * r * r
    Rect(w, h) => w * h
  }
}
fn main() {
  printFloat(ares(Rect(2.0, 3.0)))
}
