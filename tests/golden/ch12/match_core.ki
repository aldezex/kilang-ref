type Opt { No, Yes(Int) }
fn f(p: (Opt, Opt), n: Int) -> Int {
  let (a, _) = p
  match a {
    Yes(0 | -1) => 1
    Yes(k) if k > n => k
    _ => n
  }
}
fn g(p: (Opt, Opt)) -> Int {
  match p {
    (Yes(x), _) | (_, Yes(x)) if x > 0 => x
    _ => 0
  }
}
fn main() {}
